<?xml version="1.0" encoding="utf-8"?>
<!--
  cr-dotnet-0010: Web.config Transformations replaced with environment variables and AWS Systems Manager Parameter Store.
  
  This Web.Debug.config transformation file is DEPRECATED for cloud deployments.
  
  CLOUD-NATIVE REPLACEMENT STRATEGY:
  - Do NOT use build-time Web.config transformations for environment-specific configuration.
  - Instead, inject configuration at runtime via:
    1. Environment variables (DB_CONNECTION_STRING, ADMIN_EMAIL, ADMIN_PASSWORD)
    2. AWS Systems Manager Parameter Store (for non-secret configuration)
    3. AWS Secrets Manager (for sensitive values like passwords and connection strings)
  
  This approach enables:
  - Immutable build artifacts (same binary deployed to all environments)
  - Runtime configuration injection (12-factor app principle III)
  - Centralized secrets management via AWS
  - No environment-specific baking into build artifacts
  
  This file is retained for backward compatibility with local development only.
  It should NOT be used in cloud deployment pipelines.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!--
      Debug-specific settings retained for local development only.
      In cloud environments, all configuration is injected via environment variables.
    -->
  </system.web>
</configuration>
