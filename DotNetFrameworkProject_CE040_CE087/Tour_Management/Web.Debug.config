<?xml version="1.0" encoding="utf-8"?>
<!--
  MIGRATION NOTICE (cr-dotnet-0010):
  Web.config transformation files are no longer used in the migrated ASP.NET Core application.
  
  This file (Web.Debug.config) has been superseded by:
    - appsettings.Development.json for Development environment overrides
    - Environment variables for sensitive values (e.g., CONNECTIONSTRINGS__DBCONNECTION)
  
  ASP.NET Core's built-in environment-based configuration system loads:
    1. appsettings.json (base)
    2. appsettings.{ASPNETCORE_ENVIRONMENT}.json (environment-specific)
    3. Environment variables (runtime, highest priority)
  
  This enables runtime configuration without rebuilding the application,
  replacing build-time Web.config transformations.
  
  Set ASPNETCORE_ENVIRONMENT=Development to use appsettings.Development.json.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!-- Superseded by appsettings.Development.json and environment variables (cr-dotnet-0010) -->
</configuration>
