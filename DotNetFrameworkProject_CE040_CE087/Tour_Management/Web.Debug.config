<?xml version="1.0" encoding="utf-8"?>
<!--
  cr-dotnet-0010: This Web.Debug.config transformation file has been superseded by environment
  variable-based configuration using AWS Systems Manager Parameter Store.

  MIGRATION NOTICE:
  Build-time Web.config transformations (Web.Debug.config, Web.Release.config) do not work
  effectively in cloud deployment pipelines where configuration must be externalized and
  runtime-configurable.

  REPLACEMENT APPROACH:
  All environment-specific configuration is now injected at runtime via:
    1. AWS Systems Manager Parameter Store (SSM) - for non-sensitive config
    2. AWS Secrets Manager - for sensitive values (passwords, connection strings)
    3. ECS Task Definition environment variables - for container-level config

  The application reads configuration directly from environment variables:
    - DB_CONNECTION_STRING: Full RDS Proxy connection string
    - ADMIN_EMAIL: Admin login email
    - ADMIN_PASSWORD: Admin login password

  This file is retained for reference only and should NOT be used in cloud deployments.
  Set the following environment variables in your AWS deployment target instead:
    - DB_CONNECTION_STRING = <your-rds-proxy-endpoint-connection-string>
    - ADMIN_EMAIL = <admin-email-from-ssm>
    - ADMIN_PASSWORD = <admin-password-from-secrets-manager>
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Debug-specific transforms are no longer needed.
    Configuration is injected at runtime via environment variables.
    See AWS SSM Parameter Store path: /tour-management/debug/
  -->
  <system.web>
    <!-- No build-time transforms required. Use environment variables instead. -->
  </system.web>
</configuration>
