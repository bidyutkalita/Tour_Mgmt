<?xml version="1.0" encoding="utf-8"?>
<!--
  MIGRATION NOTE (cr-dotnet-0010 - Web.config Transformations):
  
  This Web.Debug.config transformation file has been superseded by ASP.NET Core's
  environment-based configuration system.
  
  Instead of build-time Web.config transformations, use runtime configuration:
  
  1. appsettings.Development.json  - Development environment overrides
  2. appsettings.Staging.json      - Staging environment overrides
  3. appsettings.Production.json   - Production environment overrides
  4. Environment variables         - Runtime configuration (highest priority)
  
  For Azure deployments, configure settings via:
  - Azure App Service > Configuration > Application Settings
  - Azure Key Vault references for secrets
  - Azure Container Apps environment variables
  
  Environment variable naming convention (replaces connectionStrings):
    CONNECTIONSTRINGS__DBCONNECTION=<your-azure-sql-connection-string>
  
  Environment variable naming convention (replaces appSettings):
    APPSETTINGS__<KEY>=<value>
  
  Debug-specific settings (previously in this file):
  - Set ASPNETCORE_ENVIRONMENT=Development
  - Connection string debug overrides via CONNECTIONSTRINGS__DBCONNECTION env var
  
  This file is retained for backward compatibility but is no longer the
  recommended approach for environment-specific configuration.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!-- Debug compilation is now controlled via ASPNETCORE_ENVIRONMENT environment variable -->
  </system.web>
</configuration>
