@page
@model Tour_Management.Pages.User.MyBookingModel
@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1>My Bookings</h1>
</div>

<div class="container">
    @if (Model.Bookings.Any())
    {
        <table style="width:100%; color:white; border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="border:1px solid white; padding:8px;">Tour Name</th>
                    <th style="border:1px solid white; padding:8px;">Place</th>
                    <th style="border:1px solid white; padding:8px;">Email</th>
                    <th style="border:1px solid white; padding:8px;">Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td style="border:1px solid white; padding:8px;">@booking.TourName</td>
                        <td style="border:1px solid white; padding:8px;">@booking.Place</td>
                        <td style="border:1px solid white; padding:8px;">@booking.Email</td>
                        <td style="border:1px solid white; padding:8px;">@booking.FirstName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No bookings found for your account.</p>
    }

    <br />
    <a href="/Tours/DisplayTours" class="btn">Browse Tours</a>
</div>
