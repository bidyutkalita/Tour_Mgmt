@page
@model Tour_Management.Pages.User.OrderModel
@{
    ViewData["Title"] = "Book Tour";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1>Book a Tour</h1>
</div>

<div class="container">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="@(Model.IsSuccess ? "alert-success" : "alert-danger")">
            @Model.StatusMessage
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Tour Name</label>
            <input asp-for="Input.TourName" class="form-control" required />
            <span asp-validation-for="Input.TourName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>City / Place</label>
            <input asp-for="Input.Place" class="form-control" required />
            <span asp-validation-for="Input.Place" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Input.Email" class="form-control" type="email" required />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>First Name</label>
            <input asp-for="Input.FirstName" class="form-control" required />
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn">Book Now</button>
            <button type="reset" class="btn">Reset</button>
        </div>
    </form>
</div>
