@page
@model Tour_Management.Pages.User.LoginModel
@{
    ViewData["Title"] = "User Login";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="page-header">
        <h1>User Login</h1>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="@(Model.IsSuccess ? "alert-success" : "alert-danger")">
            @Model.StatusMessage
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Input.Email" class="form-control" type="email" required />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Password</label>
            <input asp-for="Input.Password" class="form-control" type="password" required />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn">Login</button>
            <a href="/User/SignUp" class="btn">Sign Up</a>
        </div>
    </form>
</div>
