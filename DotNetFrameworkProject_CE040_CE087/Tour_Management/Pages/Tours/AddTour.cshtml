@page
@model Tour_Management.Pages.Tours.AddTourModel
@{
    ViewData["Title"] = "Add New Tour";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1>Add New Tour</h1>
</div>

<div class="container">
    <div class="row">
        <div class="form-horizontal col-md-7">

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="@(Model.IsSuccess ? "alert-success" : "alert-danger")">
                    @Model.StatusMessage
                </div>
            }

            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="TourName">Name of Tour</label>
                    <input asp-for="Input.TourName" class="form-control" required />
                    <span asp-validation-for="Input.TourName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="Place">Place</label>
                    <input asp-for="Input.Place" class="form-control" required />
                    <span asp-validation-for="Input.Place" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="Days">Days</label>
                    <input asp-for="Input.Days" class="form-control" type="number" required />
                    <span asp-validation-for="Input.Days" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="Locations">Locations</label>
                    <input asp-for="Input.Locations" class="form-control" required />
                    <span asp-validation-for="Input.Locations" class="text-danger"></span>
                </div>

                <div class="col-md-5">
                    <p style="text-align:center; font-size:20px;">Image for Tour</p>
                    <input type="file" name="TourImage" accept="image/*" />
                </div>

                <div class="form-group">
                    <label for="Price">Price</label>
                    <input asp-for="Input.Price" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="Input.Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="TourInfo">Tour Info</label>
                    <textarea asp-for="Input.TourInfo" class="form-control" maxlength="250"></textarea>
                    <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn">Register</button>
                    <button type="reset" class="btn">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>
