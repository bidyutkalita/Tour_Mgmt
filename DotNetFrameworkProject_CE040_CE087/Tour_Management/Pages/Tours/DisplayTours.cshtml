@page
@model Tour_Management.Pages.Tours.DisplayToursModel
@{
    ViewData["Title"] = "Display Tours";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1>Available Tours</h1>
</div>

<div class="container">
    @if (Model.Tours.Any())
    {
        <table style="width:100%; color:white; border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="border:1px solid white; padding:8px;">Tour Name</th>
                    <th style="border:1px solid white; padding:8px;">Place</th>
                    <th style="border:1px solid white; padding:8px;">Days</th>
                    <th style="border:1px solid white; padding:8px;">Price</th>
                    <th style="border:1px solid white; padding:8px;">Locations</th>
                    <th style="border:1px solid white; padding:8px;">Tour Info</th>
                    <th style="border:1px solid white; padding:8px;">Book</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tour in Model.Tours)
                {
                    <tr>
                        <td style="border:1px solid white; padding:8px;">@tour.TourName</td>
                        <td style="border:1px solid white; padding:8px;">@tour.Place</td>
                        <td style="border:1px solid white; padding:8px;">@tour.Days</td>
                        <td style="border:1px solid white; padding:8px;">@tour.Price.ToString("C")</td>
                        <td style="border:1px solid white; padding:8px;">@tour.Locations</td>
                        <td style="border:1px solid white; padding:8px;">@tour.TourInfo</td>
                        <td style="border:1px solid white; padding:8px;">
                            <a href="/User/Order?tourName=@Uri.EscapeDataString(tour.TourName)&place=@Uri.EscapeDataString(tour.Place ?? string.Empty)" class="btn">Book</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No tours available at this time.</p>
    }
</div>
