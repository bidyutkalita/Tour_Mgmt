{
  // appsettings.Development.json
  // Development environment overrides - replaces Web.Debug.config transformations.
  // This file is used when ASPNETCORE_ENVIRONMENT=Development.

  "ConnectionStrings": {
    // Local development connection string - override with environment variable for CI/CD
    "dbconnection": "Server=(localdb)\\MSSQLLocalDB;Database=tourdb;Integrated Security=True;MultipleActiveResultSets=True;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
