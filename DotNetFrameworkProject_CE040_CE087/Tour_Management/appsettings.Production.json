{
  // appsettings.Production.json
  // Production environment overrides - replaces Web.Release.config transformations.
  // This file is used when ASPNETCORE_ENVIRONMENT=Production.
  //
  // IMPORTANT: Do NOT store production secrets here.
  // Use Azure Key Vault references or environment variables for:
  //   - CONNECTIONSTRINGS__DBCONNECTION
  //   - ADMIN_EMAIL
  //   - ADMIN_PASSWORD

  "ConnectionStrings": {
    // Production connection string must be provided via environment variable:
    // CONNECTIONSTRINGS__DBCONNECTION=<azure-sql-connection-string>
    // This placeholder will be overridden by the environment variable at runtime.
    "dbconnection": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
