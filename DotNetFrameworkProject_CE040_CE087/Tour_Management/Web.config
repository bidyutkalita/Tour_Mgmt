<?xml version="1.0"?>
<!--
  MIGRATION NOTICE (cr-dotnet-0010):
  This Web.config has been superseded by ASP.NET Core configuration.
  
  The application has been migrated to ASP.NET Core Razor Pages.
  Configuration is now managed via:
    - appsettings.json (base configuration)
    - appsettings.{Environment}.json (environment-specific overrides)
    - Environment variables (runtime configuration, e.g., CONNECTIONSTRINGS__DBCONNECTION)
  
  Web.config transformation files (Web.Debug.config, Web.Release.config) are no longer
  used. Environment-specific configuration is handled by ASP.NET Core's built-in
  environment-based configuration system (cr-dotnet-0010).
  
  Connection string is now read from the CONNECTIONSTRINGS__DBCONNECTION environment
  variable or appsettings.json, enabling runtime configuration without rebuilding.
  
  See: Program.cs, appsettings.json, appsettings.Development.json, appsettings.Production.json
-->
<configuration>
  <connectionStrings>
    <!--
      CONNECTION STRING MIGRATION (cr-dotnet-0010 + cr-dotnet-0013):
      The hardcoded LocalDB connection string below has been replaced.
      In the ASP.NET Core application, set the connection string via:
        Environment variable: CONNECTIONSTRINGS__DBCONNECTION
        Or in appsettings.json: ConnectionStrings.dbconnection
      
      Azure SQL connection string format:
        Server=tcp:{server}.database.windows.net,1433;Initial Catalog={db};
        Persist Security Info=False;User ID={user};Password={password};
        MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;
        Connection Timeout=30;
      
      Original (replaced):
      Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=C:\Users\gajer\source\repos\...
    -->
  </connectionStrings>
</configuration>
