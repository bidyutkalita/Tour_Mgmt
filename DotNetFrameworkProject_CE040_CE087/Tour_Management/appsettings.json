{
  // appsettings.json - Base configuration for Tour Management application.
  // Migrated from Web.config transformations to ASP.NET Core environment-based configuration.
  // 
  // CLOUD DEPLOYMENT (cr-dotnet-0010):
  // Override connection strings and sensitive values using:
  //   - Environment variables: CONNECTIONSTRINGS__DBCONNECTION
  //   - Azure App Service Application Settings
  //   - Azure Key Vault references
  //   - Azure Container Apps environment variables
  //
  // Environment-specific overrides:
  //   appsettings.Development.json  - local development
  //   appsettings.Staging.json      - staging environment
  //   appsettings.Production.json   - production environment

  "ConnectionStrings": {
    // Override with environment variable: CONNECTIONSTRINGS__DBCONNECTION
    // Azure SQL format with Managed Identity (recommended):
    // "Server=tcp:{server}.database.windows.net,1433;Initial Catalog=tourdb;Authentication=Active Directory Managed Identity;"
    "dbconnection": "Server=tcp:your-azure-sql-server.database.windows.net,1433;Initial Catalog=tourdb;Persist Security Info=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },

  "AppSettings": {
    // Admin credentials - override via environment variables ADMIN_EMAIL and ADMIN_PASSWORD
    // or Azure Key Vault secrets for production deployments.
    "AdminEmail": "admin@gmail.com",
    "AdminPassword": "REPLACE_WITH_SECURE_PASSWORD"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*"
}
