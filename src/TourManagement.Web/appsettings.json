{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=tour_management_db;Username=postgres;Password=postgres;Pooling=true;MinPoolSize=1;MaxPoolSize=20;ConnectionIdleLifetime=300;CommandTimeout=30"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tourmanagement-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "AdminCredentials": {
    "Email": "admin@gmail.com",
    "Password": "admin"
  }
}
