@page
@model TourManagement.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body">
                <h5 class="card-title">Total Tours</h5>
                <h2>@Model.TotalTours</h2>
                <a asp-page="/Tours/Index" class="btn btn-light btn-sm">Manage Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                <h5 class="card-title">Total Users</h5>
                <h2>@Model.TotalUsers</h2>
                <a asp-page="/Admin/Users" class="btn btn-light btn-sm">Manage Users</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-dark shadow">
            <div class="card-body">
                <h5 class="card-title">Total Bookings</h5>
                <h2>@Model.TotalBookings</h2>
                <a asp-page="/Bookings/AllBookings" class="btn btn-dark btn-sm">View Bookings</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">Quick Actions</div>
            <div class="card-body">
                <a asp-page="/Tours/Create" class="btn btn-success mb-2 d-block">+ Add New Tour</a>
                <a asp-page="/Admin/Users" class="btn btn-primary mb-2 d-block">Manage Users</a>
                <a asp-page="/Bookings/AllBookings" class="btn btn-info mb-2 d-block">View All Bookings</a>
                <a asp-page="/Admin/Logout" class="btn btn-outline-danger d-block">Logout</a>
            </div>
        </div>
    </div>
</div>
