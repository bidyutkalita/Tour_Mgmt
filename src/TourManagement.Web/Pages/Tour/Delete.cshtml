@page "{id:int}"
@model TourManagement.Web.Pages.Tour.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h1>Delete Tour</h1>
<hr />

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this tour?</h4>
        <p>This action cannot be undone.</p>
    </div>

    <div class="card mb-4" style="max-width: 500px;">
        <div class="card-body">
            <h5 class="card-title">@Model.Tour.TourName</h5>
            <p><strong>Place:</strong> @Model.Tour.Place</p>
            <p><strong>Days:</strong> @Model.Tour.Days</p>
            <p><strong>Price:</strong> ₹@Model.Tour.Price</p>
        </div>
    </div>

    <form method="post">
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-page="Details" asp-route-id="@Model.Tour.TourId" class="btn btn-secondary ms-2">Cancel</a>
    </form>
}
