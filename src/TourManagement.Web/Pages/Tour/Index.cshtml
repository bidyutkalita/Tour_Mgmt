@page
@model TourManagement.Web.Pages.Tour.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Available Tours</h1>
    @if (Model.IsAdmin)
    {
        <a asp-page="Create" class="btn btn-success">+ Add New Tour</a>
    }
</div>

<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by tour name or place..." />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="Index" class="btn btn-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours found. @(string.IsNullOrEmpty(Model.SearchTerm) ? "Check back later!" : "Try a different search term.")</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var tour in Model.Tours)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/images/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height:200px;object-fit:cover;" onerror="this.style.display='none'" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted">📍 @tour.Place</p>
                        <p class="card-text">@tour.TourInfo</p>
                        <ul class="list-unstyled">
                            <li>⏱️ <strong>@tour.Days days</strong></li>
                            <li>💰 <strong>₹@tour.Price</strong></li>
                            <li>🗺️ @tour.Locations</li>
                        </ul>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-page="Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm text-white">Details</a>
                        <a asp-page="/Booking/Create" asp-route-tourName="@tour.TourName" asp-route-place="@tour.Place" class="btn btn-success btn-sm">Book</a>
                        @if (Model.IsAdmin)
                        {
                            <a asp-page="Edit" asp-route-id="@tour.TourId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-page="Delete" asp-route-id="@tour.TourId" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
