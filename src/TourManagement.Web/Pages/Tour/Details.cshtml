@page
@model TourManagement.Web.Pages.Tour.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <h1>@Model.Tour.TourName</h1>
            <p class="text-muted fs-5">📍 @Model.Tour.Place</p>

            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="~/images/@Model.Tour.Pic" class="img-fluid rounded mb-3" alt="@Model.Tour.TourName" onerror="this.style.display='none'" />
            }

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Tour Information</h5>
                    <p class="card-text">@Model.Tour.TourInfo</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <ul class="list-group">
                        <li class="list-group-item"><strong>Duration:</strong> @Model.Tour.Days days</li>
                        <li class="list-group-item"><strong>Price:</strong> ₹@Model.Tour.Price</li>
                        <li class="list-group-item"><strong>Locations:</strong> @Model.Tour.Locations</li>
                    </ul>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <a asp-page="/Booking/Create" asp-route-tourName="@Model.Tour.TourName" asp-route-place="@Model.Tour.Place" class="btn btn-success btn-lg">Book This Tour</a>
                <a asp-page="Index" class="btn btn-secondary">Back to Tours</a>
                @if (Model.IsAdmin)
                {
                    <a asp-page="Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@Model.Tour.TourId" class="btn btn-danger">Delete</a>
                }
            </div>
        </div>
    </div>
}
