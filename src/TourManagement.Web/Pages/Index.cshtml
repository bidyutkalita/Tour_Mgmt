@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <div class="jumbotron bg-dark text-white p-5 rounded mb-4">
        <h1 class="display-4">Welcome to Tour Management</h1>
        <p class="lead">Discover amazing tours and book your dream vacation today!</p>
        <hr class="my-4" />
        <p>Browse our collection of carefully curated tours to destinations around the world.</p>
        <a class="btn btn-primary btn-lg" asp-page="/Tours/Index" role="button">Explore Tours</a>
        <a class="btn btn-outline-light btn-lg ms-2" asp-page="/Users/Register" role="button">Sign Up</a>
    </div>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">🌍 Explore Destinations</h5>
                    <p class="card-text">Browse hundreds of tours to exotic destinations worldwide.</p>
                    <a asp-page="/Tours/Index" class="btn btn-outline-primary">View Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">📋 Easy Booking</h5>
                    <p class="card-text">Book your tour in just a few clicks with our simple booking system.</p>
                    <a asp-page="/Users/Login" class="btn btn-outline-primary">Book Now</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">👤 Manage Profile</h5>
                    <p class="card-text">Create an account to manage your bookings and profile.</p>
                    <a asp-page="/Users/Register" class="btn btn-outline-primary">Register</a>
                </div>
            </div>
        </div>
    </div>
</div>
