@page
@model TourManagement.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container my-4">
    <div class="alert alert-danger">
        <h2>An error occurred</h2>
        <p>Sorry, an unexpected error has occurred. Please try again later.</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
    </div>
    <a asp-page="/Index" class="btn btn-primary">Return to Home</a>
</div>
