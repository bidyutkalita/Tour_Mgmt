@page
@model TourManagement.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center">
    <h1 class="display-4">Oops!</h1>
    <p class="lead">An error occurred while processing your request.</p>
    @if (Model.RequestId != null)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-primary mt-3">Go to Home</a>
</div>
