<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tour Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Tour Management</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                @if (Context.Session.GetString("UserEmail") != null)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Profile">Profile</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Tours/Index">Tours</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Bookings/Create">Book Tour</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Bookings/MyBookings">My Bookings</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <span class="navbar-text me-2">Welcome, @Context.Session.GetString("UserEmail")</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Logout">Logout</a>
                        </li>
                    </ul>
                }
                else if (Context.Session.GetString("AdminEmail") != null)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Tours/Create">Add Tour</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Tours/Manage">Manage Tours</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Bookings/AllBookings">All Bookings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Index">Manage Users</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <span class="navbar-text me-2">Admin</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Logout">Logout</a>
                        </li>
                    </ul>
                }
                else
                {
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Login">User Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Register">Register</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Login">Admin Login</a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="footer mt-auto py-3 bg-dark text-white">
        <div class="container text-center">
            <span>&copy; @DateTime.Now.Year - Tour Management System</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
