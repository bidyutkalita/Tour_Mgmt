@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = Model.Tour?.TourName ?? "Tour Details";
}

<div class="container my-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Tours</a></li>
            <li class="breadcrumb-item active">@(Model.Tour?.TourName ?? "Details")</li>
        </ol>
    </nav>

    @if (Model.Tour is null)
    {
        <div class="alert alert-warning">Tour not found.</div>
        <a asp-page="Index" class="btn btn-secondary">Back to Tours</a>
    }
    else
    {
        <div class="row">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.Tour.Pic))
                {
                    <img src="/Tour_pics/@Model.Tour.Pic" class="img-fluid rounded shadow"
                         alt="@Model.Tour.TourName"
                         onerror="this.src='/images/default-tour.jpg'">
                }
                else
                {
                    <div class="bg-light rounded d-flex align-items-center justify-content-center"
                         style="height: 350px;">
                        <span class="text-muted" style="font-size: 5rem;">🌍</span>
                    </div>
                }
            </div>
            <div class="col-md-6">
                <h2>@Model.Tour.TourName</h2>
                <table class="table table-borderless">
                    <tr>
                        <th>Destination:</th>
                        <td>@Model.Tour.Place</td>
                    </tr>
                    <tr>
                        <th>Duration:</th>
                        <td>@Model.Tour.Days days</td>
                    </tr>
                    <tr>
                        <th>Price:</th>
                        <td class="text-success fw-bold fs-5">₹@Model.Tour.Price.ToString("N0")</td>
                    </tr>
                    <tr>
                        <th>Locations:</th>
                        <td>@Model.Tour.Locations</td>
                    </tr>
                    <tr>
                        <th>About:</th>
                        <td>@Model.Tour.TourInfo</td>
                    </tr>
                </table>
                <div class="mt-3">
                    <a asp-page="/Bookings/Create" asp-route-tourName="@Model.Tour.TourName"
                       asp-route-place="@Model.Tour.Place" class="btn btn-primary btn-lg me-2">
                        Book This Tour
                    </a>
                    <a asp-page="Index" class="btn btn-outline-secondary">Back to Tours</a>
                </div>
            </div>
        </div>
    }
</div>
