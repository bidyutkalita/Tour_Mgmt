@page
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
    var userEmail = HttpContext.Session.GetString("UserEmail");
    var isAdmin = HttpContext.Session.GetString("IsAdmin") == "true";
}

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <h1>@Model.Tour.TourName</h1>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">Destination</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>

                <dt class="col-sm-3">Duration</dt>
                <dd class="col-sm-9">@Model.Tour.Days days</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">₹@Model.Tour.Price.ToString("N0")</dd>

                <dt class="col-sm-3">Locations</dt>
                <dd class="col-sm-9">@Model.Tour.Locations</dd>

                <dt class="col-sm-3">Tour Info</dt>
                <dd class="col-sm-9">@Model.Tour.TourInfo</dd>
            </dl>

            <div class="mt-3">
                @if (userEmail != null)
                {
                    <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" class="btn btn-success">Book This Tour</a>
                }
                else
                {
                    <a asp-page="/Users/Login" class="btn btn-primary">Login to Book</a>
                }
                <a asp-page="./Index" class="btn btn-secondary ms-2">Back to Tours</a>
                @if (isAdmin)
                {
                    <a asp-page="./Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-warning ms-2">Edit</a>
                    <a asp-page="./Delete" asp-route-id="@Model.Tour.TourId" class="btn btn-danger ms-2">Delete</a>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Tour.Pic))
        {
            <div class="col-md-4">
                <img src="~/images/tours/@Model.Tour.Pic" class="img-fluid rounded shadow" alt="@Model.Tour.TourName" onerror="this.src='/images/default-tour.jpg'" />
            </div>
        }
    </div>
}
