@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = Model.Tour?.TourName ?? "Tour Details";
}

<div class="container mt-4">
    @if (Model.Tour == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>Tour not found.
            <a asp-page="Index" class="alert-link">Back to Tours</a>
        </div>
    }
    else
    {
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-page="Index">Tours</a></li>
                <li class="breadcrumb-item active">@Model.Tour.TourName</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.Tour.Pic))
                {
                    <img src="~/Tour_pics/@Model.Tour.Pic" class="img-fluid rounded shadow"
                         alt="@Model.Tour.TourName"
                         onerror="this.src='/images/default-tour.jpg'">
                }
                else
                {
                    <div class="bg-light rounded d-flex align-items-center justify-content-center shadow"
                         style="height: 350px;">
                        <i class="bi bi-image text-secondary" style="font-size: 5rem;"></i>
                    </div>
                }
            </div>
            <div class="col-md-6">
                <h1 class="mb-3">@Model.Tour.TourName</h1>
                <div class="mb-3">
                    <span class="badge bg-primary fs-6 me-2">
                        <i class="bi bi-calendar me-1"></i>@Model.Tour.Days Days
                    </span>
                    <span class="badge bg-success fs-6">
                        <i class="bi bi-currency-rupee me-1"></i>@Model.Tour.Price.ToString("N0")
                    </span>
                </div>
                <table class="table table-borderless">
                    <tr>
                        <th class="text-muted" style="width: 140px;">
                            <i class="bi bi-geo-alt me-2"></i>Destination
                        </th>
                        <td>@Model.Tour.Place</td>
                    </tr>
                    <tr>
                        <th class="text-muted">
                            <i class="bi bi-map me-2"></i>Locations
                        </th>
                        <td>@Model.Tour.Locations</td>
                    </tr>
                    <tr>
                        <th class="text-muted">
                            <i class="bi bi-calendar-date me-2"></i>Duration
                        </th>
                        <td>@Model.Tour.Days Days</td>
                    </tr>
                    <tr>
                        <th class="text-muted">
                            <i class="bi bi-cash me-2"></i>Price
                        </th>
                        <td class="fw-bold text-success fs-5">₹@Model.Tour.Price.ToString("N0")</td>
                    </tr>
                </table>
                <h5 class="mt-3">About This Tour</h5>
                <p class="text-muted">@Model.Tour.TourInfo</p>
                <div class="d-flex gap-2 mt-4">
                    <a asp-page="/Bookings/Create"
                       asp-route-tourId="@Model.Tour.TourId"
                       asp-route-tourName="@Model.Tour.TourName"
                       asp-route-place="@Model.Tour.Place"
                       class="btn btn-success btn-lg">
                        <i class="bi bi-calendar-plus me-2"></i>Book This Tour
                    </a>
                    <a asp-page="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left me-2"></i>Back to Tours
                    </a>
                </div>
            </div>
        </div>
    }
</div>
