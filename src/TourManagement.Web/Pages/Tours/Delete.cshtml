@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<div class="container my-4">
    <h2 class="text-danger">Delete Tour</h2>
    <p class="lead">Are you sure you want to delete this tour?</p>

    @if (Model.Tour is null)
    {
        <div class="alert alert-warning">Tour not found.</div>
        <a asp-page="Index" class="btn btn-secondary">Back to Tours</a>
    }
    else
    {
        <div class="card border-danger mb-4" style="max-width: 500px;">
            <div class="card-header bg-danger text-white">Tour to be deleted</div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Tour Name:</dt>
                    <dd class="col-sm-8">@Model.Tour.TourName</dd>
                    <dt class="col-sm-4">Place:</dt>
                    <dd class="col-sm-8">@Model.Tour.Place</dd>
                    <dt class="col-sm-4">Days:</dt>
                    <dd class="col-sm-8">@Model.Tour.Days</dd>
                    <dt class="col-sm-4">Price:</dt>
                    <dd class="col-sm-8">₹@Model.Tour.Price.ToString("N0")</dd>
                </dl>
            </div>
        </div>

        <form method="post">
            <input type="hidden" name="id" value="@Model.Tour.TourId" />
            <button type="submit" class="btn btn-danger me-2">Yes, Delete</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    }
</div>
