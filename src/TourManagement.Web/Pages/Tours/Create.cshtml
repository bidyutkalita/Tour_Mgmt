@page
@model TourManagement.Web.Pages.Tours.CreateModel
@{
    ViewData["Title"] = "Add New Tour";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-dark text-white text-center">
                <h2>Add New Tour</h2>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Input.TourName" class="form-label"></label>
                        <input asp-for="Input.TourName" class="form-control" />
                        <span asp-validation-for="Input.TourName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Place" class="form-label"></label>
                        <input asp-for="Input.Place" class="form-control" />
                        <span asp-validation-for="Input.Place" class="text-danger"></span>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Days" class="form-label"></label>
                            <input asp-for="Input.Days" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Input.Days" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Price" class="form-label"></label>
                            <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Input.Price" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Locations" class="form-label"></label>
                        <input asp-for="Input.Locations" class="form-control" />
                        <span asp-validation-for="Input.Locations" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.TourInfo" class="form-label"></label>
                        <textarea asp-for="Input.TourInfo" class="form-control" rows="4" maxlength="500"></textarea>
                        <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tour Image</label>
                        <input type="file" name="tourImage" class="form-control" accept="image/*" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Add Tour</button>
                        <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
