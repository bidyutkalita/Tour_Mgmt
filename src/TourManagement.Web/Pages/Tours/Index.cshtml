@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "All Tours";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>All Tours</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add New Tour
            </a>
        }
    </div>

    <!-- Search Form -->
    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm"
                   class="form-control" placeholder="Search by tour name or place..." />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-page="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Tours.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var tour in Model.Tours)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(tour.Pic))
                        {
                            <img src="/Tour_pics/@tour.Pic" class="card-img-top" alt="@tour.TourName"
                                 style="height: 200px; object-fit: cover;"
                                 onerror="this.src='/images/default-tour.jpg'">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <span class="text-muted fs-1">🌍</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text">
                                <span class="badge bg-info text-dark">@tour.Place</span>
                                <span class="badge bg-secondary">@tour.Days days</span>
                            </p>
                            <p class="card-text small text-muted">@tour.TourInfo</p>
                            <p class="card-text small"><strong>Locations:</strong> @tour.Locations</p>
                        </div>
                        <div class="card-footer">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-success">₹@tour.Price.ToString("N0")</span>
                                <div>
                                    <a asp-page="Details" asp-route-id="@tour.TourId"
                                       class="btn btn-outline-primary btn-sm">Details</a>
                                    <a asp-page="/Bookings/Create" asp-route-tourName="@tour.TourName"
                                       asp-route-place="@tour.Place" class="btn btn-primary btn-sm">Book</a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-page="Edit" asp-route-id="@tour.TourId"
                                           class="btn btn-warning btn-sm">Edit</a>
                                        <a asp-page="Delete" asp-route-id="@tour.TourId"
                                           class="btn btn-danger btn-sm">Delete</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <span>No tours found matching "<strong>@Model.SearchTerm</strong>".</span>
            }
            else
            {
                <span>No tours available at the moment.</span>
            }
        </div>
    }
</div>
