@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "All Tours";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-map me-2"></i>All Tours</h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="Create" class="btn btn-success">
                <i class="bi bi-plus-circle me-2"></i>Add New Tour
            </a>
        }
    </div>

    <!-- Search Form -->
    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm"
                   class="form-control" placeholder="Search tours by name or place..." />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search me-1"></i>Search
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-page="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </a>
            }
        </div>
    </form>

    @if (!Model.Tours.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle me-2"></i>
            @(string.IsNullOrEmpty(Model.SearchTerm) ? "No tours available at the moment." : $"No tours found for '{Model.SearchTerm}'.")
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(tour.Pic))
                        {
                            <img src="~/Tour_pics/@tour.Pic" class="card-img-top" alt="@tour.TourName"
                                 style="height: 200px; object-fit: cover;"
                                 onerror="this.src='/images/default-tour.jpg'">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text">
                                <i class="bi bi-geo-alt text-danger me-1"></i>@tour.Place
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-info text-dark">
                                    <i class="bi bi-calendar me-1"></i>@tour.Days Days
                                </span>
                                <span class="fw-bold text-success fs-5">₹@tour.Price.ToString("N0")</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="d-flex gap-2">
                                <a asp-page="Details" asp-route-id="@tour.TourId"
                                   class="btn btn-primary flex-fill">
                                    <i class="bi bi-info-circle me-1"></i>Details
                                </a>
                                <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId"
                                   asp-route-tourName="@tour.TourName" asp-route-place="@tour.Place"
                                   class="btn btn-success flex-fill">
                                    <i class="bi bi-calendar-plus me-1"></i>Book
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-page="Edit" asp-route-id="@tour.TourId"
                                       class="btn btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-page="Delete" asp-route-id="@tour.TourId"
                                       class="btn btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
