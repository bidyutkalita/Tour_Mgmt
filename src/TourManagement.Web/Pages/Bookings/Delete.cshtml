@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Cancel Booking";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-x-circle me-2"></i>Cancel Booking</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Are you sure you want to cancel this booking?
                    </div>
                    @if (Model.Booking != null)
                    {
                        <dl class="row">
                            <dt class="col-sm-4">Tour Name</dt>
                            <dd class="col-sm-8">@Model.Booking.TourName</dd>
                            <dt class="col-sm-4">Place</dt>
                            <dd class="col-sm-8">@Model.Booking.Place</dd>
                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">@Model.Booking.FirstName</dd>
                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.Booking.Email</dd>
                        </dl>
                        <form method="post">
                            <input type="hidden" name="id" value="@Model.Booking.BookingId" />
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-x-circle me-2"></i>Yes, Cancel Booking
                                </button>
                                <a asp-page="MyBookings" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-2"></i>Keep Booking
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
