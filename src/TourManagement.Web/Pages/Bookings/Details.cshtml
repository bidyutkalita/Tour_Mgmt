@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<div class="container mt-4">
    @if (Model.Booking == null)
    {
        <div class="alert alert-warning">Booking not found. <a asp-page="MyBookings">Back to My Bookings</a></div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="bi bi-ticket-detailed me-2"></i>Booking Details</h4>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Booking ID</dt>
                            <dd class="col-sm-8">#@Model.Booking.BookingId</dd>
                            <dt class="col-sm-4">Tour Name</dt>
                            <dd class="col-sm-8">@Model.Booking.TourName</dd>
                            <dt class="col-sm-4">Place</dt>
                            <dd class="col-sm-8">@Model.Booking.Place</dd>
                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">@Model.Booking.FirstName</dd>
                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.Booking.Email</dd>
                            <dt class="col-sm-4">Booked On</dt>
                            <dd class="col-sm-8">@Model.Booking.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
                            <dt class="col-sm-4">Status</dt>
                            <dd class="col-sm-8">
                                @if (Model.Booking.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Cancelled</span>
                                }
                            </dd>
                        </dl>
                        <div class="d-flex gap-2 mt-3">
                            <a asp-page="MyBookings" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Back to My Bookings
                            </a>
                            <a asp-page="Delete" asp-route-id="@Model.Booking.BookingId"
                               class="btn btn-outline-danger">
                                <i class="bi bi-trash me-2"></i>Cancel Booking
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
