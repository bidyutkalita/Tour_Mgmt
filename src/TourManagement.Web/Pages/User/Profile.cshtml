@page
@model TourManagement.Web.Pages.User.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

@if (Model.UserProfile == null)
{
    <div class="alert alert-warning">Profile not found.</div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <h1>My Profile</h1>
            <hr />

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <div class="card shadow">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.UserProfile.Email</dd>

                        <dt class="col-sm-4">First Name</dt>
                        <dd class="col-sm-8">@Model.UserProfile.FirstName</dd>

                        <dt class="col-sm-4">Last Name</dt>
                        <dd class="col-sm-8">@Model.UserProfile.LastName</dd>

                        <dt class="col-sm-4">Gender</dt>
                        <dd class="col-sm-8">@Model.UserProfile.Gender</dd>

                        <dt class="col-sm-4">Date of Birth</dt>
                        <dd class="col-sm-8">@Model.UserProfile.Dob.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@Model.UserProfile.Street, @Model.UserProfile.City, @Model.UserProfile.State</dd>
                    </dl>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <a asp-page="/Booking/MyBookings" class="btn btn-info text-white">My Bookings</a>
                <a asp-page="/Tour/Index" class="btn btn-primary">Browse Tours</a>
                <a asp-page="Logout" class="btn btn-outline-danger">Logout</a>
            </div>
        </div>
    </div>
}
