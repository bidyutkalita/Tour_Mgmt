@page
@model TourManagement.Web.Pages.User.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1 class="text-center mb-4">Create Account</h1>

        <div class="card shadow">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RegisterForm.FirstName" class="form-label"></label>
                            <input asp-for="RegisterForm.FirstName" class="form-control" />
                            <span asp-validation-for="RegisterForm.FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="RegisterForm.LastName" class="form-label"></label>
                            <input asp-for="RegisterForm.LastName" class="form-control" />
                            <span asp-validation-for="RegisterForm.LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RegisterForm.Email" class="form-label"></label>
                        <input asp-for="RegisterForm.Email" class="form-control" />
                        <span asp-validation-for="RegisterForm.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RegisterForm.Password" class="form-label"></label>
                        <input asp-for="RegisterForm.Password" class="form-control" type="password" />
                        <span asp-validation-for="RegisterForm.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RegisterForm.Gender" class="form-label"></label>
                        <select asp-for="RegisterForm.Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="RegisterForm.Gender" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RegisterForm.Dob" class="form-label"></label>
                        <input asp-for="RegisterForm.Dob" class="form-control" type="date" />
                        <span asp-validation-for="RegisterForm.Dob" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RegisterForm.Street" class="form-label"></label>
                        <input asp-for="RegisterForm.Street" class="form-control" />
                        <span asp-validation-for="RegisterForm.Street" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RegisterForm.City" class="form-label"></label>
                            <input asp-for="RegisterForm.City" class="form-control" />
                            <span asp-validation-for="RegisterForm.City" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="RegisterForm.State" class="form-label"></label>
                            <input asp-for="RegisterForm.State" class="form-control" />
                            <span asp-validation-for="RegisterForm.State" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success">Register</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="text-center mt-3">
            <p>Already have an account? <a asp-page="Login">Login here</a></p>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
