@page "{email}"
@model TourManagement.Web.Pages.Users.EditModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Profile</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Input.Email" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Email</label>
                                <input value="@Model.Input.Email" class="form-control" readonly disabled />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.FirstName" class="form-label fw-semibold"></label>
                                <input asp-for="Input.FirstName" class="form-control" />
                                <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.LastName" class="form-label fw-semibold"></label>
                                <input asp-for="Input.LastName" class="form-control" />
                                <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Gender" class="form-label fw-semibold"></label>
                                <select asp-for="Input.Gender" class="form-select">
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Input.Gender" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Dob" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Dob" class="form-control" type="date" />
                                <span asp-validation-for="Input.Dob" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Street" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Street" class="form-control" />
                                <span asp-validation-for="Input.Street" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.City" class="form-label fw-semibold"></label>
                                <input asp-for="Input.City" class="form-control" />
                                <span asp-validation-for="Input.City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.State" class="form-label fw-semibold"></label>
                                <input asp-for="Input.State" class="form-control" />
                                <span asp-validation-for="Input.State" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-circle me-2"></i>Save Changes
                            </button>
                            <a asp-page="Profile" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
