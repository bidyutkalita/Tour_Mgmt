@page
@model TourManagement.Web.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container my-4">
    <h2>My Profile</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.UserProfile is not null)
    {
        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Personal Information</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Email:</dt>
                            <dd class="col-sm-8">@Model.UserProfile.Email</dd>
                            <dt class="col-sm-4">Name:</dt>
                            <dd class="col-sm-8">@Model.UserProfile.FirstName @Model.UserProfile.LastName</dd>
                            <dt class="col-sm-4">Gender:</dt>
                            <dd class="col-sm-8">@Model.UserProfile.Gender</dd>
                            <dt class="col-sm-4">Date of Birth:</dt>
                            <dd class="col-sm-8">@Model.UserProfile.Dob.ToString("dd MMM yyyy")</dd>
                            <dt class="col-sm-4">Address:</dt>
                            <dd class="col-sm-8">@Model.UserProfile.Street, @Model.UserProfile.City, @Model.UserProfile.State</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a asp-page="/Tours/Index" class="btn btn-outline-primary">Browse Tours</a>
                            <a asp-page="/Bookings/MyBookings" class="btn btn-outline-success">My Bookings</a>
                            <a asp-page="/Users/Logout" class="btn btn-outline-danger">Logout</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Profile not found. Please <a asp-page="Login">login</a> again.
        </div>
    }
</div>
