@page
@model TourManagement.Web.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center">
                    <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 80px; height: 80px;">
                        <i class="bi bi-person-fill text-white" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="card-title">@Model.User?.FirstName @Model.User?.LastName</h5>
                    <p class="text-muted">@Model.User?.Email</p>
                    <a asp-page="Edit" asp-route-email="@Model.User?.Email" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i>Edit Profile
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Profile Details</h5>
                </div>
                <div class="card-body">
                    @if (Model.User != null)
                    {
                        <dl class="row">
                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.User.Email</dd>
                            <dt class="col-sm-4">First Name</dt>
                            <dd class="col-sm-8">@Model.User.FirstName</dd>
                            <dt class="col-sm-4">Last Name</dt>
                            <dd class="col-sm-8">@Model.User.LastName</dd>
                            <dt class="col-sm-4">Gender</dt>
                            <dd class="col-sm-8">@Model.User.Gender</dd>
                            <dt class="col-sm-4">Date of Birth</dt>
                            <dd class="col-sm-8">@Model.User.Dob.ToString("dd MMM yyyy")</dd>
                            <dt class="col-sm-4">Address</dt>
                            <dd class="col-sm-8">@Model.User.Street, @Model.User.City, @Model.User.State</dd>
                        </dl>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>My Bookings</h5>
                    <a asp-page="/Bookings/MyBookings" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (!Model.RecentBookings.Any())
                    {
                        <p class="text-muted text-center">No bookings yet.
                            <a asp-page="/Tours/Index">Browse tours</a> to make your first booking!
                        </p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <strong>@booking.TourName</strong>
                                        <small class="text-muted">@booking.CreatedDate.ToString("dd MMM yyyy")</small>
                                    </div>
                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>@booking.Place
                                    </small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
